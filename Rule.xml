<rule id="100502" level="12">
  <if_group>sysmon_event1</if_group>
  <field name="win.eventdata.image" type="pcre2">(?i)\\schtasks\.exe$</field>
  <field name="win.eventdata.commandLine" type="pcre2">(?i)/create</field>
  <description>Custom Detection: Scheduled Task Created Using schtasks.exe</description>
  <group>local,windows,sysmon,persistence,scheduled_task,attack.persistence,</group>
  <mitre>
    <id>T1053.005</id>
  </mitre>
</rule>
